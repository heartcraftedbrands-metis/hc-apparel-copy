# Public browser configuration only. Add these names to Vercel for Production,
# Preview, and Development as needed.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy projects may use this name instead of VITE_SUPABASE_PUBLISHABLE_KEY:
# VITE_SUPABASE_ANON_KEY=eyJ_REPLACE_ME

# Never add SUPABASE_SERVICE_ROLE_KEY, SS_API_KEY, SS_ACCOUNT_NUMBER, Stripe
# secret keys, or other backend credentials to a VITE_ variable.
# Social Media Studio uses Supabase Edge Function secrets, not VITE_ variables:
# OPENAI_API_KEY=... (required for image/copy generation)
# OPENAI_TEXT_MODEL=gpt-4o-mini (optional)
# OPENAI_IMAGE_MODEL=gpt-image-1 (optional)
# SOCIAL_STUDIO_ENCRYPTION_KEY=... (base64-encoded 32 random bytes; required for Buffer connection)
# BUFFER_API_KEY=... (optional server-only fallback if not connecting from the admin page)
