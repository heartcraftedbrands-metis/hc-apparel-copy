{
  "name": "CustomerNotification",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Linked customer Order ID"
    },
    "order_number": {
      "type": "string",
      "description": "Order number for display"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "order_received",
        "awaiting_payment",
        "payment_confirmed",
        "preparing_order",
        "sent_to_production",
        "in_production",
        "shipped",
        "delivered",
        "completed",
        "custom_update"
      ],
      "description": "Type of notification"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "customer_message": {
      "type": "string",
      "description": "Message shown to customer"
    },
    "related_status": {
      "type": "string",
      "description": "Related order/payment/fulfillment status"
    },
    "sent_status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_to_send",
        "sent",
        "failed"
      ],
      "default": "draft",
      "description": "Current notification status"
    },
    "customer_visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether customer can see this on Track Order page"
    },
    "admin_note": {
      "type": "string",
      "description": "Internal admin note"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "When notification was sent"
    },
    "auto_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was auto-created by a status trigger"
    },
    "trigger_event": {
      "type": "string",
      "description": "What event triggered auto-generation (e.g., 'status_change:payment_confirmed')"
    }
  },
  "required": [
    "order_id",
    "order_number",
    "customer_name",
    "customer_email",
    "notification_type",
    "subject",
    "customer_message"
  ]
}