{
  "name": "PaymentFeeSettings",
  "type": "object",
  "properties": {
    "stripe_fee_buffer_percent": {
      "type": "number",
      "default": 3.5,
      "description": "Stripe processing fee buffer as percentage"
    },
    "stripe_fixed_fee_buffer": {
      "type": "number",
      "default": 0.5,
      "description": "Stripe processing fee fixed amount in dollars"
    },
    "paypal_fee_buffer_percent": {
      "type": "number",
      "default": 4.0,
      "description": "PayPal processing fee buffer as percentage"
    },
    "paypal_fixed_fee_buffer": {
      "type": "number",
      "default": 0.5,
      "description": "PayPal processing fee fixed amount in dollars"
    },
    "additional_profit_buffer_percent": {
      "type": "number",
      "default": 0,
      "description": "Additional profit margin buffer as percentage"
    },
    "price_rounding_mode": {
      "type": "string",
      "enum": [
        "none",
        "nearest_99",
        "nearest_49",
        "whole_dollar"
      ],
      "default": "nearest_99",
      "description": "How to round final prices"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": []
}